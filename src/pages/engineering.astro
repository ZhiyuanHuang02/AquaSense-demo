---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionNav from '../components/SectionNav.astro';

const sections = [
  { href: '#method', label: 'Method' },
  { href: '#cycles', label: 'DBTL cycles' },
  { href: '#decisions', label: 'Decisions' },
  { href: '#roadmap', label: 'Roadmap' },
];

const cycles = [
  {
    id: 'cycle-1', number: '01', title: 'Make the signal interpretable', focus: 'Interface',
    design: 'Begin with a continuous color gradient representing reporter intensity.',
    build: 'Prototype a printed reference scale and a circular reaction window.',
    test: 'Five volunteer readers classified simulated colors under two lighting conditions.',
    learn: 'Adjacent colors were difficult to distinguish and a gradient implied false precision.',
    change: 'Replace the gradient with three named bands, icons, and written next steps.',
  },
  {
    id: 'cycle-2', number: '02', title: 'Separate signal from failure', focus: 'Reliability',
    design: 'Use one reaction window to display the target-responsive output.',
    build: 'Map the sample path from inlet through the freeze-dried reaction pad.',
    test: 'Run a failure-mode review covering insufficient volume, expired reagents, and incomplete activation.',
    learn: 'A blank window could mean either a low result or a test that never ran.',
    change: 'Add a separate procedural control and make “invalid” a first-class result state.',
  },
  {
    id: 'cycle-3', number: '03', title: 'Contain the full sample path', focus: 'Biosafety',
    design: 'House the reaction in a snap-fit two-piece cartridge.',
    build: 'Sketch an exploded stack with a sample well, membrane, reaction pad, and absorbent layer.',
    test: 'Review opening points, spill paths, disposal behavior, and user handling after activation.',
    learn: 'A reusable shell introduced contamination and encouraged reopening after use.',
    change: 'Move to a sealed single-use cartridge with a one-way inlet and tamper-evident seam.',
  },
];
---

<BaseLayout title="Engineering" description="Follow AquaSense through three documented design–build–test–learn cycles, key tradeoffs, and a staged validation roadmap.">
  <PageHero index="02" eyebrow="Engineering" title="Every iteration should leave a trace." lead="AquaSense uses design–build–test–learn cycles to connect a problem, a prototype, an observation, and a concrete change—without pretending a concept study is a finished device." />

  <div class="page-shell">
    <SectionNav items={sections} />
    <article class="page-content">
      <section id="method" data-reveal>
        <div class="split align-start">
          <div class="copy-block">
            <p class="eyebrow">01 · Method</p>
            <h2>Learn before adding.</h2>
            <p class="lead">The engineering cycle is treated as a decision record—not a decorative loop.</p>
            <p>Each cycle begins with one uncertainty, selects the lowest-cost prototype that can expose it, and ends with an explicit change. Because this is a concept project, “build” includes interface mockups, architecture diagrams, and failure-mode analyses rather than fabricated laboratory work.</p>
          </div>
          <div class="cycle-figure" role="img" aria-label="Circular design, build, test, learn process">
            <svg viewBox="0 0 500 500" aria-hidden="true">
              <defs><path id="ring" d="M250,250 m-170,0 a170,170 0 1,1 340,0 a170,170 0 1,1 -340,0" /></defs>
              <circle cx="250" cy="250" r="170" fill="none" stroke="currentColor" stroke-opacity=".15" stroke-width="45" stroke-dasharray="205 62"/>
              <text><textPath href="#ring" startOffset="3%">DESIGN · BUILD · TEST · LEARN ·</textPath></text>
              <path d="M250 133c-56 0-102 45-102 101 0 67 88 134 102 144 14-10 102-77 102-144 0-56-46-101-102-101Z" fill="var(--aqua)" opacity=".2"/>
              <path d="M250 164c-39 0-70 31-70 70s31 70 70 70 70-31 70-70-31-70-70-70Z" fill="var(--lime)"/>
              <path d="M221 233h58M250 204v58" stroke="#062f35" stroke-width="8" stroke-linecap="round"/>
            </svg>
          </div>
        </div>
      </section>

      <section id="cycles" data-reveal>
        <div class="section-heading">
          <p class="eyebrow">02 · DBTL cycles</p>
          <h2>Three uncertainties, three changes.</h2>
          <p>Select a cycle to inspect the evidence trail. The interactions are keyboard accessible and preserve a linear reading order without JavaScript.</p>
        </div>

        <div class="cycle-tabs" data-cycle-tabs>
          <div class="tab-list" role="tablist" aria-label="Engineering cycles">
            {cycles.map((cycle, index) => (
              <button type="button" id={`tab-${cycle.id}`} role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={cycle.id} tabindex={index === 0 ? 0 : -1}>
                <span>{cycle.number}</span><b>{cycle.title}</b><small>{cycle.focus}</small>
              </button>
            ))}
          </div>
          <div class="tab-panels">
            {cycles.map((cycle, index) => (
              <section id={cycle.id} role="tabpanel" aria-labelledby={`tab-${cycle.id}`} hidden={index !== 0}>
                <div class="cycle-title"><span class="mono">Cycle {cycle.number} · {cycle.focus}</span><h3>{cycle.title}</h3></div>
                <div class="dbtl-grid">
                  <article><span>D</span><div><b>Design</b><p>{cycle.design}</p></div></article>
                  <article><span>B</span><div><b>Build</b><p>{cycle.build}</p></div></article>
                  <article><span>T</span><div><b>Test</b><p>{cycle.test}</p></div></article>
                  <article><span>L</span><div><b>Learn</b><p>{cycle.learn}</p></div></article>
                </div>
                <div class="change-note"><span>Change carried forward</span><p>{cycle.change}</p></div>
              </section>
            ))}
          </div>
        </div>
      </section>

      <section id="decisions" data-reveal>
        <div class="section-heading">
          <p class="eyebrow">03 · Decision log</p>
          <h2>Tradeoffs made visible.</h2>
          <p>The “best” option depends on the requirement being protected. Recording the rejected path makes later revision easier.</p>
        </div>
        <div class="table-wrap">
          <table>
            <caption class="sr-only">AquaSense engineering decision log</caption>
            <thead><tr><th>Decision</th><th>Selected</th><th>Alternative</th><th>Reason</th><th>Cost</th></tr></thead>
            <tbody>
              <tr><td>Biological format</td><td><strong>Cell-free</strong></td><td>Whole-cell</td><td>Improves containment and simplifies field handling.</td><td>May reduce stability or signal amplification.</td></tr>
              <tr><td>Readout</td><td><strong>Visual bands</strong></td><td>Phone-only quantification</td><td>Works without a personal device or connectivity.</td><td>Lower quantitative resolution.</td></tr>
              <tr><td>Enclosure</td><td><strong>Sealed, single-use</strong></td><td>Reusable reader</td><td>Reduces spills, carryover, and maintenance.</td><td>Creates a disposal burden.</td></tr>
              <tr><td>Result model</td><td><strong>Screen + confirm</strong></td><td>Definitive pass/fail</td><td>Matches the evidence a field screen can responsibly provide.</td><td>Requires a follow-up pathway.</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section id="roadmap" data-reveal>
        <div class="section-heading">
          <p class="eyebrow">04 · Validation roadmap</p>
          <h2>What comes before “works.”</h2>
          <p>A staged plan prevents a visually compelling prototype from outrunning the evidence behind it.</p>
        </div>
        <ol class="roadmap">
          <li class="complete"><span>01</span><div><b>Interaction prototype</b><p>Validate language, result hierarchy, and error states with representative users.</p></div><em>Concept complete</em></li>
          <li><span>02</span><div><b>Molecular feasibility</b><p>Characterize dose response, baseline expression, and time-to-signal in a controlled buffer.</p></div><em>Proposed</em></li>
          <li><span>03</span><div><b>Selectivity panel</b><p>Challenge the system with copper, zinc, iron, calcium, pH variation, and mixed samples.</p></div><em>Proposed</em></li>
          <li><span>04</span><div><b>Matrix testing</b><p>Compare performance across tap, surface, and well-water matrices using certified controls.</p></div><em>Proposed</em></li>
          <li><span>05</span><div><b>Field and usability study</b><p>Evaluate handling, comprehension, transport, storage, and confirmatory-testing uptake.</p></div><em>Proposed</em></li>
        </ol>
      </section>
    </article>
  </div>

  <script>
    document.querySelectorAll<HTMLElement>('[data-cycle-tabs]').forEach((tabs) => {
      const buttons = [...tabs.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const panels = [...tabs.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
      const select = (button: HTMLButtonElement) => {
        buttons.forEach((item) => {
          const active = item === button;
          item.setAttribute('aria-selected', String(active));
          item.tabIndex = active ? 0 : -1;
        });
        panels.forEach((panel) => { panel.hidden = panel.id !== button.getAttribute('aria-controls'); });
      };
      buttons.forEach((button, index) => {
        button.addEventListener('click', () => select(button));
        button.addEventListener('keydown', (event) => {
          if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
          event.preventDefault();
          let next = index;
          if (event.key === 'ArrowLeft') next = (index - 1 + buttons.length) % buttons.length;
          if (event.key === 'ArrowRight') next = (index + 1) % buttons.length;
          if (event.key === 'Home') next = 0;
          if (event.key === 'End') next = buttons.length - 1;
          const nextButton = buttons[next];
          if (nextButton) { select(nextButton); nextButton.focus(); }
        });
      });
    });
  </script>
</BaseLayout>

<style>
  .cycle-figure { min-height: 440px; display: grid; place-items: center; background: var(--aqua-pale); border-radius: 50%; }
  .cycle-figure svg { width: min(100%, 440px); }
  .cycle-figure text { fill: var(--ink); font: 500 19px 'DM Mono', monospace; letter-spacing: 6px; }
  .cycle-tabs { border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--paper-raised); }
  .tab-list { display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid var(--line); }
  .tab-list button { min-height: 180px; padding: 1.5rem; border: 0; border-right: 1px solid var(--line); background: transparent; text-align: left; cursor: pointer; }
  .tab-list button:last-child { border-right: 0; }
  .tab-list button[aria-selected='true'] { background: var(--aqua-pale); box-shadow: inset 0 -4px var(--aqua-deep); }
  .tab-list span, .tab-list small { display: block; font: 500 .65rem 'DM Mono', monospace; text-transform: uppercase; letter-spacing: .08em; }
  .tab-list span { color: var(--coral); }
  .tab-list b { display: block; margin: 2rem 0 .45rem; line-height: 1.2; }
  .tab-list small { color: var(--ink-soft); }
  .tab-panels > section { padding: clamp(1.5rem, 5vw, 4rem); }
  .cycle-title { display: grid; grid-template-columns: .7fr 2fr; gap: 2rem; align-items: baseline; margin-bottom: 2rem; }
  .cycle-title span { color: var(--aqua-deep); }
  .cycle-title h3 { margin: 0; }
  .dbtl-grid { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--line); border-radius: 1rem; overflow: hidden; }
  .dbtl-grid article { display: grid; grid-template-columns: 42px 1fr; gap: 1rem; padding: 1.5rem; }
  .dbtl-grid article:nth-child(odd) { border-right: 1px solid var(--line); }
  .dbtl-grid article:nth-child(n+3) { border-top: 1px solid var(--line); }
  .dbtl-grid article > span { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--navy); color: #edf9f5; font: 500 .75rem 'DM Mono', monospace; }
  .dbtl-grid article:nth-child(4) > span { background: var(--lime); color: #062f35; }
  .dbtl-grid p { margin: .35rem 0 0; color: var(--ink-soft); font-size: .87rem; }
  .change-note { margin-top: 1rem; padding: 1.3rem 1.5rem; background: var(--lime); color: #062f35; border-radius: 1rem; }
  .change-note span { font: 500 .65rem 'DM Mono', monospace; text-transform: uppercase; letter-spacing: .08em; }
  .change-note p { margin: .35rem 0 0; font-weight: 700; }
  .roadmap { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .roadmap li { display: grid; grid-template-columns: 70px minmax(0, 1fr) auto; gap: 1.5rem; align-items: start; padding: 1.6rem 0; border-bottom: 1px solid var(--line); }
  .roadmap li > span { color: var(--coral); font: 500 .7rem 'DM Mono', monospace; }
  .roadmap b { font-size: 1.05rem; }
  .roadmap p { margin: .25rem 0 0; color: var(--ink-soft); }
  .roadmap em { padding: .3rem .55rem; border: 1px solid var(--line); border-radius: 99px; color: var(--ink-soft); font: normal 500 .6rem 'DM Mono', monospace; text-transform: uppercase; white-space: nowrap; }
  .roadmap .complete em { background: var(--aqua-pale); border-color: transparent; color: var(--aqua-deep); }
  @media (max-width: 720px) {
    .tab-list { grid-template-columns: 1fr; }
    .tab-list button { min-height: 125px; border-right: 0; border-bottom: 1px solid var(--line); }
    .tab-list button:last-child { border-bottom: 0; }
    .tab-list b { margin-top: 1rem; }
    .cycle-title, .dbtl-grid { grid-template-columns: 1fr; }
    .dbtl-grid article:nth-child(odd) { border-right: 0; }
    .dbtl-grid article:nth-child(n+2) { border-top: 1px solid var(--line); }
    .roadmap li { grid-template-columns: 40px 1fr; }
    .roadmap em { grid-column: 2; justify-self: start; }
  }
</style>
