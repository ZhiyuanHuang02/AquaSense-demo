---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionNav from '../components/SectionNav.astro';

const sections = [
  { href: '#status', label: 'Evidence status' },
  { href: '#response', label: 'Signal response' },
  { href: '#specificity', label: 'Specificity' },
  { href: '#usability', label: 'Usability' },
  { href: '#gaps', label: 'Open questions' },
];

const concentrations = [0, 5, 10, 25, 50, 100];
const initialValues = [0.08, 0.12, 0.22, 0.41, 0.72, 0.91];
const xPos = (value: number) => 70 + value * 6.1;
const yPos = (value: number) => 310 - value * 240;
const initialPath = initialValues.map((value, index) => `${index === 0 ? 'M' : 'L'} ${xPos(concentrations[index] ?? 0)} ${yPos(value)}`).join(' ');
---

<BaseLayout title="Results" description="Explore AquaSense's illustrative response data, specificity assumptions, interface evaluation, and evidence gaps through accessible charts and tables.">
  <PageHero index="03" eyebrow="Results" title="Show the evidence. Label the assumption." lead="This page demonstrates how a content-heavy technical result can remain legible and honest. Molecular values and interface-evaluation values are explicitly illustrative." />

  <div class="page-shell">
    <SectionNav items={sections} />
    <article class="page-content">
      <section id="status" data-reveal>
        <div class="section-heading">
          <p class="eyebrow">01 · Evidence status</p>
          <h2>Not every result carries the same weight.</h2>
          <p>Every claim is tagged so readers can distinguish completed design work from simulated values and future validation.</p>
        </div>
        <div class="evidence-grid">
          <article><span class="evidence-dot documented"></span><b>Documented</b><p>Produced within this concept project: architecture, interface prototypes, decision records.</p></article>
          <article><span class="evidence-dot illustrative"></span><b>Illustrative</b><p>Invented data used only to demonstrate visualization, interpretation, and page behavior.</p></article>
          <article><span class="evidence-dot proposed"></span><b>Proposed</b><p>A method or validation step that would need to be conducted in future work.</p></article>
        </div>
        <div class="notice">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2.8 20h18.4L12 3Zm0 6v5m0 3h.01" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <p><strong>Important:</strong> the dose-response and interference values below are illustrative. They do not demonstrate analytical performance and must not be used for real water-quality decisions.</p>
        </div>
      </section>

      <section id="response" data-reveal>
        <div class="section-heading">
          <p class="eyebrow">02 · Illustrative response</p>
          <h2>One chart, two ways to read it.</h2>
          <p>Switch the selected ion to compare a proposed target response with low cross-reactivity examples. The same values are available in the table below.</p>
        </div>
        <div class="chart-card">
          <div class="chart-toolbar">
            <div>
              <span class="chart-label">Display series</span>
              <div class="series-buttons" role="group" aria-label="Select chart series">
                <button type="button" data-series="lead" aria-pressed="true">Lead (Pb²⁺)</button>
                <button type="button" data-series="copper" aria-pressed="false">Copper (Cu²⁺)</button>
                <button type="button" data-series="zinc" aria-pressed="false">Zinc (Zn²⁺)</button>
              </div>
            </div>
            <div class="chart-summary" aria-live="polite"><strong id="series-name">Lead</strong><span id="series-summary">Illustrative target response</span></div>
          </div>

          <div class="chart-scroll">
            <svg class="response-chart" viewBox="0 0 740 370" role="img" aria-labelledby="chart-title chart-desc">
              <title id="chart-title">Illustrative normalized reporter response</title>
              <desc id="chart-desc">Lead response rises from 0.08 at zero micrograms per litre to 0.91 at 100 micrograms per litre.</desc>
              <g class="chart-grid" aria-hidden="true">
                <path d="M70 70H680M70 130H680M70 190H680M70 250H680M70 310H680" />
                <path d="M70 310V70" />
              </g>
              <g class="axis-labels" aria-hidden="true">
                <text x="55" y="314">0</text><text x="55" y="254">.25</text><text x="55" y="194">.50</text><text x="55" y="134">.75</text><text x="55" y="74">1.0</text>
                {concentrations.map((value) => <text x={xPos(value)} y="337" text-anchor="middle">{value}</text>)}
                <text class="axis-title" x="375" y="365" text-anchor="middle">Concentration (µg/L)</text>
                <text class="axis-title" x="15" y="190" transform="rotate(-90 15 190)" text-anchor="middle">Normalized output</text>
              </g>
              <path id="response-area" d={`${initialPath} L 680 310 L 70 310 Z`} fill="var(--aqua)" opacity=".14" />
              <path id="response-line" d={initialPath} fill="none" stroke="var(--aqua-deep)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
              <g id="response-points">
                {initialValues.map((value, index) => <circle cx={xPos(concentrations[index] ?? 0)} cy={yPos(value)} r="7" fill="var(--paper-raised)" stroke="var(--aqua-deep)" stroke-width="4" />)}
              </g>
              <path d={`M ${xPos(10)} 310V70`} stroke="var(--coral)" stroke-width="2" stroke-dasharray="5 6" opacity=".8" />
              <text x={xPos(10) + 8} y="91" fill="var(--coral)" class="threshold-label">REFERENCE LINE · 10 µg/L</text>
            </svg>
          </div>

          <details class="data-disclosure">
            <summary>View chart data as a table</summary>
            <div class="table-wrap">
              <table>
                <caption id="table-caption">Illustrative normalized response for lead</caption>
                <thead><tr><th>Concentration (µg/L)</th><th>Normalized output</th><th>Evidence status</th></tr></thead>
                <tbody id="response-table">
                  {concentrations.map((value, index) => <tr><td>{value}</td><td>{initialValues[index]?.toFixed(2)}</td><td>Illustrative</td></tr>)}
                </tbody>
              </table>
            </div>
          </details>
        </div>
      </section>

      <section id="specificity" data-reveal>
        <div class="split align-start">
          <div class="copy-block">
            <p class="eyebrow">03 · Proposed specificity panel</p>
            <h2>The sample is more than the target.</h2>
            <p class="lead">A field biosensor must be challenged with competing ions and realistic water matrices—not only clean buffer.</p>
            <p>The bars visualize the same illustrative endpoint values used above. In future work, the panel would include mixtures, pH variation, hardness, organic matter, and blinded controls.</p>
            <ul class="tag-list"><li class="tag">Illustrative data</li><li class="tag">n/a replicates</li><li class="tag">Not validated</li></ul>
          </div>
          <div class="bar-chart" role="img" aria-label="Illustrative endpoint responses: lead 91 percent, copper 15 percent, zinc 12 percent, iron 18 percent">
            <div><span>Pb²⁺</span><i style="--value:91%"></i><b>0.91</b></div>
            <div><span>Cu²⁺</span><i style="--value:15%"></i><b>0.15</b></div>
            <div><span>Zn²⁺</span><i style="--value:12%"></i><b>0.12</b></div>
            <div><span>Fe³⁺</span><i style="--value:18%"></i><b>0.18</b></div>
            <small>Normalized output at illustrative 100 µg/L endpoint</small>
          </div>
        </div>
      </section>

      <section id="usability" data-reveal>
        <div class="section-heading">
          <p class="eyebrow">04 · Interface evaluation</p>
          <h2>What a small prototype can teach.</h2>
          <p>A sample dataset for five hypothetical readers compares two result-card concepts. It demonstrates how a small formative evaluation could be reported; no user study was conducted.</p>
        </div>
        <div class="usability-grid">
          <article class="card lime"><span class="mono">Illustrative</span><strong>5 / 5</strong><h3>find the named bands</h3><p>Example outcome: readers locate “low,” “follow up,” and “priority follow-up” without prompting.</p></article>
          <article class="card"><span class="mono">Illustrative</span><strong>4 / 5</strong><h3>notice the confirmation note</h3><p>Example finding: one reader skips from color to action, motivating stronger hierarchy.</p></article>
          <article class="card accent"><span class="mono">Proposed change</span><strong>Aa</strong><h3>text travels with color</h3><p>Icons and explicit labels would duplicate every color-coded state.</p></article>
        </div>
      </section>

      <section id="gaps" data-reveal>
        <div class="section-heading">
          <p class="eyebrow">05 · Open questions</p>
          <h2>The most useful result may be the next question.</h2>
        </div>
        <div class="questions">
          <details open><summary>Can the proposed regulator distinguish lead in complex samples?</summary><div>Selectivity must be measured across individual interferents, mixtures, realistic pH and hardness ranges, and blinded environmental samples.</div></details>
          <details><summary>Will the freeze-dried reaction remain stable during transport?</summary><div>Accelerated aging, temperature cycling, humidity exposure, packaging permeability, and rehydration consistency would all need to be characterized.</div></details>
          <details><summary>Can people interpret the result in uncontrolled lighting?</summary><div>A larger study should include diverse lighting, color-vision differences, literacy levels, languages, and comparison with an optional phone-based reader.</div></details>
          <details><summary>What happens after a priority result?</summary><div>The device is only responsible if a locally funded confirmation, communication, and remediation pathway exists before screening begins.</div></details>
        </div>
      </section>
    </article>
  </div>

  <script>
    const series = {
      lead: { name: 'Lead', summary: 'Illustrative target response', values: [0.08, 0.12, 0.22, 0.41, 0.72, 0.91], color: 'var(--aqua-deep)' },
      copper: { name: 'Copper', summary: 'Illustrative low cross-response', values: [0.07, 0.08, 0.09, 0.10, 0.13, 0.15], color: 'var(--coral)' },
      zinc: { name: 'Zinc', summary: 'Illustrative low cross-response', values: [0.06, 0.07, 0.08, 0.10, 0.11, 0.12], color: 'var(--lime)' },
    } as const;
    const concentrations = [0, 5, 10, 25, 50, 100];
    type SeriesKey = keyof typeof series;
    const x = (value: number) => 70 + value * 6.1;
    const y = (value: number) => 310 - value * 240;
    const line = document.querySelector<SVGPathElement>('#response-line');
    const area = document.querySelector<SVGPathElement>('#response-area');
    const points = document.querySelector<SVGGElement>('#response-points');
    const name = document.querySelector<HTMLElement>('#series-name');
    const summary = document.querySelector<HTMLElement>('#series-summary');
    const table = document.querySelector<HTMLTableSectionElement>('#response-table');
    const caption = document.querySelector<HTMLElement>('#table-caption');
    const desc = document.querySelector<SVGDescElement>('#chart-desc');

    const render = (key: SeriesKey) => {
      const selected = series[key];
      const path = selected.values.map((value, index) => `${index === 0 ? 'M' : 'L'} ${x(concentrations[index] ?? 0)} ${y(value)}`).join(' ');
      line?.setAttribute('d', path);
      line?.setAttribute('stroke', selected.color);
      area?.setAttribute('d', `${path} L 680 310 L 70 310 Z`);
      if (points) points.innerHTML = selected.values.map((value, index) => `<circle cx="${x(concentrations[index] ?? 0)}" cy="${y(value)}" r="7" fill="var(--paper-raised)" stroke="${selected.color}" stroke-width="4" />`).join('');
      if (name) name.textContent = selected.name;
      if (summary) summary.textContent = selected.summary;
      if (caption) caption.textContent = `Illustrative normalized response for ${selected.name.toLowerCase()}`;
      if (desc) desc.textContent = `${selected.name} response ranges from ${selected.values[0]} at zero micrograms per litre to ${selected.values.at(-1)} at 100 micrograms per litre.`;
      if (table) table.innerHTML = concentrations.map((value, index) => `<tr><td>${value}</td><td>${selected.values[index]?.toFixed(2)}</td><td>Illustrative</td></tr>`).join('');
      document.querySelectorAll<HTMLButtonElement>('[data-series]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.series === key)));
    };
    document.querySelectorAll<HTMLButtonElement>('[data-series]').forEach((button) => button.addEventListener('click', () => render(button.dataset.series as SeriesKey)));
  </script>
</BaseLayout>

<style>
  .evidence-grid { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .evidence-grid article { padding: 1.7rem; background: var(--paper-raised); }
  .evidence-grid article + article { border-left: 1px solid var(--line); }
  .evidence-grid b { display: block; margin: 1.5rem 0 .4rem; }
  .evidence-grid p { margin: 0; color: var(--ink-soft); font-size: .86rem; }
  .evidence-dot { display: block; width: 18px; height: 18px; border-radius: 50%; }
  .documented { background: var(--aqua); } .illustrative { background: var(--coral); } .proposed { background: transparent; border: 2px dashed var(--ink-soft); }
  .chart-card { background: var(--paper-raised); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .chart-toolbar { display: flex; justify-content: space-between; gap: 2rem; align-items: end; padding: 1.5rem; border-bottom: 1px solid var(--line); }
  .series-buttons { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .6rem; }
  .series-buttons button { padding: .45rem .75rem; border: 1px solid var(--line); border-radius: 99px; background: transparent; cursor: pointer; font-size: .76rem; font-weight: 700; }
  .series-buttons button[aria-pressed='true'] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .chart-summary { text-align: right; }
  .chart-summary strong, .chart-summary span { display: block; }
  .chart-summary strong { font-size: 1.5rem; line-height: 1.1; }
  .chart-summary span { color: var(--ink-soft); font-size: .75rem; }
  .chart-scroll { overflow-x: auto; padding: 1.5rem; }
  .response-chart { min-width: 700px; }
  .chart-grid path { fill: none; stroke: var(--line); stroke-width: 1; }
  .axis-labels text { fill: var(--ink-soft); font: 12px 'DM Mono', monospace; }
  .axis-labels .axis-title { font-size: 11px; letter-spacing: .05em; text-transform: uppercase; }
  .response-chart .threshold-label { font: 10px 'DM Mono', monospace; letter-spacing: .05em; }
  .data-disclosure { border-bottom: 0; padding-inline: 1.5rem; }
  .bar-chart { padding: 2rem; background: var(--navy); color: #edf9f5; border-radius: var(--radius); }
  .bar-chart > div { display: grid; grid-template-columns: 50px 1fr 42px; gap: .8rem; align-items: center; margin-bottom: 1.5rem; }
  .bar-chart span, .bar-chart b { font: 500 .72rem 'DM Mono', monospace; }
  .bar-chart i { display: block; width: var(--value); height: 26px; background: var(--aqua); border-radius: 0 99px 99px 0; }
  .bar-chart div:nth-child(n+2) i { background: var(--coral); }
  .bar-chart small { color: #a9c8c5; }
  .usability-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .usability-grid .card { min-height: 360px; }
  .usability-grid strong { display: block; margin: 3rem 0 1.2rem; font-size: clamp(3rem, 6vw, 5rem); line-height: 1; letter-spacing: -.07em; }
  .questions { border-radius: var(--radius); }
  @media (max-width: 800px) {
    .evidence-grid, .usability-grid { grid-template-columns: 1fr; }
    .evidence-grid article + article { border-left: 0; border-top: 1px solid var(--line); }
    .chart-toolbar { align-items: start; flex-direction: column; }
    .chart-summary { text-align: left; }
  }
</style>
